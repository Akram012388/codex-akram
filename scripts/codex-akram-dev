#!/bin/sh

set -eu

script_path=$0
while [ -L "$script_path" ]; do
  script_dir=$(CDPATH= cd -P -- "$(dirname -- "$script_path")" && pwd)
  link_target=$(readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path=$script_dir/$link_target ;;
  esac
done

script_dir=$(CDPATH= cd -P -- "$(dirname -- "$script_path")" && pwd)
repo_root=$(CDPATH= cd -P -- "$script_dir/.." && pwd)
dev_binary="$repo_root/codex-rs/target/debug/codex-akram"

if [ ! -x "$dev_binary" ]; then
  echo "codex-akram-dev is not built; building it once..." >&2
  cargo build \
    --manifest-path "$repo_root/codex-rs/Cargo.toml" \
    --bin codex-akram
fi

CODEX_AKRAM_HOME="${CODEX_AKRAM_HOME:-$HOME/.codex-akram-dev}" \
HERDR_AGENT=codex \
exec "$dev_binary" "$@"
